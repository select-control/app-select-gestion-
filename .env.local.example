# ==========================================================================
# CONFIGURACION DE SUPABASE
# --------------------------------------------------------------------------
# Copia este archivo y renombralo a ".env.local" (sin .example)
# Luego pega aqui los datos de tu proyecto de Supabase.
#
# Donde encontrarlos: en supabase.com -> tu proyecto ->
#   Settings (rueda dentada) -> API
# ==========================================================================

# "Project URL"  (algo como https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" key (clave publica, empieza por eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key (clave SECRETA, tambien empieza por eyJ...)
# Solo se usa en el servidor para crear/gestionar usuarios desde la pagina /usuarios.
# NUNCA la compartas ni la subas a internet.
SUPABASE_SERVICE_ROLE_KEY=
